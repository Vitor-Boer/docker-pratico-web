# Tudo aqui é opcional: sem nenhuma variável o site sobe e funciona.

# URL da API local, do ponto de vista do NAVEGADOR (por isso 127.0.0.1 + porta publicada;
# não `localhost` — em algumas máquinas, sobretudo Linux, o navegador tenta IPv6 primeiro
# e trava se o Docker só publicou a porta em IPv4).
# O nome `api` da rede Docker só resolve entre containers, não no navegador.
# Atenção: NEXT_PUBLIC_* é embutida no build; mudar depois exige rebuild da imagem.
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"

# Hub do apresentador. O padrão já vem no código; só preencha para apontar para outro hub
# (um local, por exemplo: http://localhost:5000).
# NEXT_PUBLIC_HUB_URL="https://prod-docker-pratico.gljr8e.easypanel.host"
