# Opcional. URL da API local, do ponto de vista do NAVEGADOR (por isso localhost + porta publicada).
# O nome `api` da rede Docker só resolve entre containers, não no navegador.
# Atenção: NEXT_PUBLIC_* é embutida no build; mudar depois exige rebuild da imagem.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Token único recebido no início do evento (URL curta / QR code).
# Usado pela API do participante, não pelo site. O compose repassa para o serviço `api`.
PARTICIPANT_TOKEN="CHANGE_ME"

# URL do hub, definida pelo apresentador. Também repassada à API.
HUB_URL="CHANGE_ME"
