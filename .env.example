# Tudo aqui é opcional: sem nenhuma variável o site sobe e funciona.

# URL da API local, do ponto de vista do NAVEGADOR (por isso localhost + porta publicada).
# O nome `api` da rede Docker só resolve entre containers, não no navegador.
# Atenção: NEXT_PUBLIC_* é embutida no build; mudar depois exige rebuild da imagem.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Hub do apresentador. O padrão já vem no código; só preencha para apontar para outro hub.
# NEXT_PUBLIC_HUB_URL="https://hub.docker-na-pratica.com"
