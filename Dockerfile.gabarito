# Gabarito do Dockerfile do site. NÃO faz parte do desafio — é a resposta, preenchendo as
# lacunas TODO(workshop) do Dockerfile ao lado. Comitado de propósito: quem não quiser ver
# a resposta antes de tentar, evite abrir este arquivo.

# ---- Estágio 1: build ----
FROM node:22-alpine AS build
WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build

# ---- Estágio 2: runtime (imagem final enxuta) ----
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
